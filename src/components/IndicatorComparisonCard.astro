---
import {
  calcularDiferenca,
  calcularVariacao,
  formatarDecimalBR,
  isUnidadePercentual,
  isValorNumerico,
  type Indicador,
} from '../lib/data';
import { withBase } from '../lib/paths';

interface Props {
  indicador: Indicador;
  /** Se true, uma variação positiva é considerada melhora (ex: PIB). Se false, uma
   * variação negativa é a melhora (ex: desemprego, inflação, desmatamento). */
  aumentoEBom?: boolean;
  /** Se true, a variação é mostrada só como alta/queda, sem classificar como melhora ou
   * piora — para indicadores em que isso seria juízo de valor (ex: câmbio, valores nominais). */
  semJulgamento?: boolean;
  /** Se true, o mandato ainda não terminou — os labels e textos refletem um corte
   * parcial (dado mais recente) em vez de um resultado final de mandato. */
  mandatoEmAndamento?: boolean;
}

const { indicador, aumentoEBom = true, semJulgamento = false, mandatoEmAndamento = false } = Astro.props;
// Indicadores de valor único (total ou média anual no mandato) não têm início/fim nem variação.
const ehValorUnico = indicador.tipo_valor === 'total_mandato' || indicador.tipo_valor === 'media_anual';
const valorUnico =
  indicador.tipo_valor === 'media_anual' ? indicador.valor_media_anual : indicador.valor_total_mandato;
const labelValorUnico = indicador.tipo_valor === 'media_anual' ? 'Média anual no mandato' : 'Total no mandato';

// Indicadores em % variam em pontos percentuais; os demais, em variação relativa (%).
const emPontosPercentuais = isUnidadePercentual(indicador.unidade);
const variacao = ehValorUnico
  ? null
  : emPontosPercentuais
    ? calcularDiferenca(indicador.valor_inicio_mandato ?? '', indicador.valor_fim_mandato ?? '')
    : calcularVariacao(indicador.valor_inicio_mandato ?? '', indicador.valor_fim_mandato ?? '');
const unidadeVariacao = emPontosPercentuais ? ' p.p.' : '%';
const temDados = ehValorUnico
  ? isValorNumerico(valorUnico ?? '')
  : isValorNumerico(indicador.valor_inicio_mandato ?? '') &&
    isValorNumerico(indicador.valor_fim_mandato ?? '');

const labelSegundoValor = mandatoEmAndamento ? 'Dado mais recente' : 'Fim do mandato';
const sufixoVariacao = mandatoEmAndamento ? ' até o momento' : ' no mandato';

// Abaixo destes limites a variação é tratada como estável (0,5% relativo; 0,05 p.p. = arredonda a 0,0).
const limiteEstavel = emPontosPercentuais ? 0.05 : 0.5;

let tendencia: 'melhora' | 'piora' | 'estavel' | null = null;
if (variacao !== null) {
  if (Math.abs(variacao) < limiteEstavel || semJulgamento) tendencia = 'estavel';
  else if ((variacao > 0 && aumentoEBom) || (variacao < 0 && !aumentoEBom)) tendencia = 'melhora';
  else tendencia = 'piora';
}

// A seta mostra a direção do valor (sobe/desce); melhora ou piora fica no texto e na cor.
let textoVariacao = '';
let iconeVariacao = '→';
if (variacao !== null && tendencia) {
  const valor = `${formatarDecimalBR(Math.abs(variacao))}${unidadeVariacao}`;
  if (Math.abs(variacao) < limiteEstavel) {
    textoVariacao = `Estável${sufixoVariacao}`;
  } else {
    iconeVariacao = variacao > 0 ? '↑' : '↓';
    textoVariacao = semJulgamento
      ? `${variacao > 0 ? 'Alta' : 'Queda'} de ${valor}${sufixoVariacao}`
      : `${valor} de ${tendencia === 'melhora' ? 'melhora' : 'piora'}${sufixoVariacao}`;
  }
}

const tendenciaStyles = {
  melhora: { text: 'text-melhora-texto', bg: 'bg-melhora-bg' },
  piora: { text: 'text-piora-texto', bg: 'bg-piora-bg' },
  estavel: { text: 'text-estavel-texto', bg: 'bg-estavel-bg' },
};
---

<div class="rounded-2xl border border-linha bg-superficie p-4 shadow-cartao">
  <h4 class="text-sm font-semibold text-texto">{indicador.nome}</h4>
  <p class="text-xs break-words text-suave [overflow-wrap:anywhere]">Fonte: {indicador.fonte}</p>

  {
    ehValorUnico ? (
      <div class="mt-3">
        <span class="block text-xs uppercase tracking-wide text-suave-2">{labelValorUnico}</span>
        <span class="text-lg font-bold text-texto">
          {valorUnico}{temDados ? ` ${indicador.unidade}` : ''}
        </span>
      </div>
    ) : (
      <div class="mt-3 grid grid-cols-2 gap-3">
        <div>
          <span class="block text-xs uppercase tracking-wide text-suave-2">Início do mandato</span>
          <span class="text-lg font-bold text-texto">
            {indicador.valor_inicio_mandato}{temDados ? ` ${indicador.unidade}` : ''}
          </span>
        </div>
        <div>
          <span class="block text-xs uppercase tracking-wide text-suave-2">{labelSegundoValor}</span>
          <span class="text-lg font-bold text-texto">
            {indicador.valor_fim_mandato}{temDados ? ` ${indicador.unidade}` : ''}
          </span>
        </div>
      </div>
    )
  }

  {
    !temDados ? (
      <div class="mt-3 rounded-lg bg-sutil px-2 py-1 text-xs font-medium text-suave">
        Dado ainda não preenchido (PLACEHOLDER)
      </div>
    ) : tendencia ? (
      <div class={`mt-3 flex items-center gap-2 rounded-lg px-2 py-1 ${tendenciaStyles[tendencia].bg}`}>
        <span class={`text-base font-bold ${tendenciaStyles[tendencia].text}`} aria-hidden="true">
          {iconeVariacao}
        </span>
        <span class={`text-sm font-medium ${tendenciaStyles[tendencia].text}`}>
          {textoVariacao}
        </span>
      </div>
    ) : null
  }

  <a
    href={withBase(`/correcao?item=${indicador.id}`)}
    class="mt-3 inline-block text-xs text-suave-2 underline hover:text-texto-2"
  >
    Reportar erro
  </a>
</div>
