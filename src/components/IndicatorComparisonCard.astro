---
import { calcularVariacao, isValorNumerico, type Indicador } from '../lib/data';

interface Props {
  indicador: Indicador;
  /** Se true, uma variação positiva é considerada melhora (ex: PIB). Se false, uma
   * variação negativa é a melhora (ex: desemprego, inflação, desmatamento). */
  aumentoEBom?: boolean;
  /** Se true, o mandato ainda não terminou — os labels e textos refletem um corte
   * parcial (dado mais recente) em vez de um resultado final de mandato. */
  mandatoEmAndamento?: boolean;
}

const { indicador, aumentoEBom = true, mandatoEmAndamento = false } = Astro.props;
// Indicadores de valor único (total ou média anual no mandato) não têm início/fim nem variação.
const ehValorUnico = indicador.tipo_valor === 'total_mandato' || indicador.tipo_valor === 'media_anual';
const valorUnico =
  indicador.tipo_valor === 'media_anual' ? indicador.valor_media_anual : indicador.valor_total_mandato;
const labelValorUnico = indicador.tipo_valor === 'media_anual' ? 'Média anual no mandato' : 'Total no mandato';

const variacao = ehValorUnico
  ? null
  : calcularVariacao(indicador.valor_inicio_mandato ?? '', indicador.valor_fim_mandato ?? '');
const temDados = ehValorUnico
  ? isValorNumerico(valorUnico ?? '')
  : isValorNumerico(indicador.valor_inicio_mandato ?? '') &&
    isValorNumerico(indicador.valor_fim_mandato ?? '');

const labelSegundoValor = mandatoEmAndamento ? 'Dado mais recente' : 'Fim do mandato';
const sufixoVariacao = mandatoEmAndamento ? ' até o momento' : ' no mandato';

let tendencia: 'melhora' | 'piora' | 'estavel' | null = null;
if (variacao !== null) {
  if (Math.abs(variacao) < 0.5) tendencia = 'estavel';
  else if ((variacao > 0 && aumentoEBom) || (variacao < 0 && !aumentoEBom)) tendencia = 'melhora';
  else tendencia = 'piora';
}

const tendenciaStyles = {
  melhora: { text: 'text-green-700', bg: 'bg-green-50', icon: '↑' },
  piora: { text: 'text-red-700', bg: 'bg-red-50', icon: '↓' },
  estavel: { text: 'text-slate-600', bg: 'bg-slate-50', icon: '→' },
};
---

<div class="rounded-lg border border-slate-200 bg-white p-4">
  <h4 class="text-sm font-semibold text-slate-900">{indicador.nome}</h4>
  <p class="text-xs text-slate-500">Fonte: {indicador.fonte}</p>

  {
    ehValorUnico ? (
      <div class="mt-3">
        <span class="block text-xs uppercase tracking-wide text-slate-400">{labelValorUnico}</span>
        <span class="text-lg font-bold text-slate-900">
          {valorUnico}{temDados ? ` ${indicador.unidade}` : ''}
        </span>
      </div>
    ) : (
      <div class="mt-3 grid grid-cols-2 gap-3">
        <div>
          <span class="block text-xs uppercase tracking-wide text-slate-400">Início do mandato</span>
          <span class="text-lg font-bold text-slate-900">
            {indicador.valor_inicio_mandato}{temDados ? ` ${indicador.unidade}` : ''}
          </span>
        </div>
        <div>
          <span class="block text-xs uppercase tracking-wide text-slate-400">{labelSegundoValor}</span>
          <span class="text-lg font-bold text-slate-900">
            {indicador.valor_fim_mandato}{temDados ? ` ${indicador.unidade}` : ''}
          </span>
        </div>
      </div>
    )
  }

  {
    !temDados ? (
      <div class="mt-3 rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-500">
        Dado ainda não preenchido (PLACEHOLDER)
      </div>
    ) : tendencia ? (
      <div class={`mt-3 flex items-center gap-2 rounded-md px-2 py-1 ${tendenciaStyles[tendencia].bg}`}>
        <span class={`text-base font-bold ${tendenciaStyles[tendencia].text}`}>
          {tendenciaStyles[tendencia].icon}
        </span>
        <span class={`text-sm font-medium ${tendenciaStyles[tendencia].text}`}>
          {Math.abs(variacao ?? 0).toFixed(1)}% {tendencia === 'melhora' ? 'de melhora' : tendencia === 'piora' ? 'de piora' : 'estável'}{sufixoVariacao}
        </span>
      </div>
    ) : null
  }
</div>
