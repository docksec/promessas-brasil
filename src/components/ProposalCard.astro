---
import StatusBadge from './StatusBadge.astro';
import type { Proposta, Eixo } from '../lib/data';
import { withBase } from '../lib/paths';

interface Props {
  proposta: Proposta;
  eixo?: Eixo;
}

const { proposta, eixo } = Astro.props;
---

<a
  href={withBase(`/proposta/${proposta.id}`)}
  class="block rounded-lg border border-slate-200 bg-white p-4 transition hover:border-slate-300 hover:shadow-sm"
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      {eixo && (
        <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">
          {eixo.nome} · {proposta.categoria}
        </span>
      )}
      <h3 class="mt-1 truncate text-base font-semibold text-slate-900">{proposta.titulo}</h3>
    </div>
    <StatusBadge status={proposta.status} size="sm" />
  </div>

  <p class="mt-2 line-clamp-2 text-sm text-slate-600">{proposta.descricao_original}</p>

  {
    proposta.referencia_documento && (
      <p class="mt-1 text-xs text-slate-400">Doc.: {proposta.referencia_documento}</p>
    )
  }

  <div class="mt-3">
    <div class="h-2 w-full overflow-hidden rounded-full bg-slate-100">
      <div
        class="h-full rounded-full bg-slate-700"
        style={`width: ${proposta.percentual_cumprimento}%`}
      >
      </div>
    </div>
    <span class="mt-1 block text-right text-xs text-slate-500">
      {proposta.percentual_cumprimento}% cumprido
    </span>
  </div>
</a>
