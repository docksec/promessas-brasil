---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Radar de Propostas',
  description = 'Acompanhamento independente de propostas de campanha de presidentes do Brasil.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';

const links = [
  { caminho: '', rotulo: 'Início' },
  { caminho: 'comparar', rotulo: 'Comparar' },
  { caminho: 'metodologia', rotulo: 'Metodologia' },
  { caminho: 'correcao', rotulo: 'Reportar erro' },
  { caminho: 'doacao', rotulo: 'Apoiar' },
];
const paginaAtual = Astro.url.pathname.replace(/\/$/, '');
const isAtual = (caminho: string) => paginaAtual === `${base}${caminho}`.replace(/\/$/, '');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <title>{title} | Radar de Propostas</title>
    <script is:inline>
      // Aplica o tema antes da primeira pintura, para a página não piscar no tema errado.
      // Sem escolha salva, segue a preferência do sistema operacional.
      (function () {
        var tema = null;
        try {
          tema = localStorage.getItem('tema');
        } catch (e) {}
        if (tema !== 'claro' && tema !== 'escuro') {
          tema = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'escuro' : 'claro';
        }
        document.documentElement.dataset.tema = tema;
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-fundo text-texto antialiased">
    <header class="px-4 pt-4 sm:px-6">
      <div
        class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-1 gap-y-1 rounded-2xl border border-linha bg-superficie py-2 pr-2 pl-5 shadow-cartao md:rounded-full"
      >
        <a href={base} class="order-1 mr-auto text-lg font-extrabold tracking-tight text-texto">
          Radar de Propostas
        </a>
        {/* No celular: título e botão de tema na 1ª linha, menu embaixo; no desktop, tudo em linha. */}
        <nav class="order-3 -ml-3 flex w-full flex-wrap gap-1 text-sm font-semibold md:order-2 md:ml-0 md:w-auto">
          {
            links.map(({ caminho, rotulo }) => (
              <a
                href={`${base}${caminho}`}
                aria-current={isAtual(caminho) ? 'page' : undefined}
                class={
                  isAtual(caminho)
                    ? 'rounded-full bg-primario px-4 py-2.5 text-sobre-primario'
                    : 'rounded-full px-4 py-2.5 text-texto-2 hover:bg-sutil hover:text-texto'
                }
              >
                {rotulo}
              </a>
            ))
          }
        </nav>
        <button
          type="button"
          id="alternar-tema"
          aria-label="Usar tema escuro"
          title="Alternar tema claro/escuro"
          class="order-2 flex h-11 w-11 items-center justify-center rounded-full text-texto-2 hover:bg-sutil hover:text-texto md:order-3"
        >
          <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
          <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6">
      <slot />
    </main>

    <footer class="border-t border-linha">
      <div class="mx-auto max-w-6xl px-4 py-6 text-center text-xs text-suave sm:px-6">
        Este é um projeto independente de acompanhamento de propostas de campanha, sem
        vínculo com partidos políticos. Fontes e metodologia disponíveis na página{' '}
        <a href={`${base}metodologia`} class="underline hover:text-texto-2">Metodologia</a>.
      </div>
    </footer>

    <script>
      const botao = document.getElementById('alternar-tema');
      const raiz = document.documentElement;

      function atualizarRotulo() {
        const escuro = raiz.dataset.tema === 'escuro';
        botao?.setAttribute('aria-label', escuro ? 'Usar tema claro' : 'Usar tema escuro');
      }

      botao?.addEventListener('click', () => {
        const novo = raiz.dataset.tema === 'escuro' ? 'claro' : 'escuro';
        raiz.dataset.tema = novo;
        try {
          localStorage.setItem('tema', novo);
        } catch {
          // Sem armazenamento disponível (ex: navegação privada): o tema vale só nesta página.
        }
        atualizarRotulo();
      });

      // Sem escolha salva, acompanha a troca de tema do sistema operacional.
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (evento) => {
        let salvo = null;
        try {
          salvo = localStorage.getItem('tema');
        } catch {}
        if (salvo) return;
        raiz.dataset.tema = evento.matches ? 'escuro' : 'claro';
        atualizarRotulo();
      });

      atualizarRotulo();
    </script>
  </body>
</html>
