---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Radar de Propostas',
  description = 'Acompanhamento independente de propostas de campanha de presidentes do Brasil.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <title>{title} | Radar de Propostas</title>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-4 sm:px-6">
        <a href={base} class="text-lg font-bold tracking-tight text-slate-900">
          Radar de Propostas
        </a>
        <nav class="flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium text-slate-600 sm:gap-x-6">
          <a href={base} class="hover:text-slate-900">Início</a>
          <a href={`${base}comparar`} class="hover:text-slate-900">Comparar</a>
          <a href={`${base}metodologia`} class="hover:text-slate-900">Metodologia</a>
          <a href={`${base}correcao`} class="hover:text-slate-900">Reportar erro</a>
          <a href={`${base}doacao`} class="hover:text-slate-900">Apoiar</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-6 text-center text-xs text-slate-500 sm:px-6">
        Este é um projeto independente de acompanhamento de propostas de campanha, sem
        vínculo com partidos políticos. Fontes e metodologia disponíveis na página{' '}
        <a href={`${base}metodologia`} class="underline hover:text-slate-700">Metodologia</a>.
      </div>
    </footer>
  </body>
</html>
