---
import Layout from '../../layouts/Layout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { propostas, getPresidente, getEixo } from '../../lib/data';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return propostas.map((proposta) => ({
    params: { id: proposta.id },
    props: { proposta },
  }));
}

const { proposta } = Astro.props;
const presidente = getPresidente(proposta.presidente_id);
const eixo = getEixo(proposta.eixo);
---

<Layout title={proposta.titulo}>
  <a href={withBase(`/presidente/${proposta.presidente_id}`)} class="text-sm text-slate-500 hover:underline">
    ← Voltar para {presidente?.nome}
  </a>

  <div class="mt-4 flex flex-wrap items-start justify-between gap-4">
    <div>
      <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">
        {eixo?.nome} · {proposta.categoria}
      </span>
      <h1 class="mt-1 text-2xl font-bold text-slate-900">{proposta.titulo}</h1>
    </div>
    <StatusBadge status={proposta.status} />
  </div>

  <div class="mt-4">
    <div class="h-2 w-full max-w-md overflow-hidden rounded-full bg-slate-100">
      <div class="h-full rounded-full bg-slate-700" style={`width: ${proposta.percentual_cumprimento}%`}></div>
    </div>
    <span class="mt-1 block text-sm text-slate-500">
      {proposta.percentual_cumprimento}% cumprido · última atualização em {proposta.data_ultima_atualizacao}
    </span>
  </div>

  <section class="mt-8 rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Proposta original</h2>
    <p class="mt-2 text-slate-800">{proposta.descricao_original}</p>
    <p class="mt-3 text-xs text-slate-500">Fonte: {proposta.fonte_proposta}</p>
    {
      proposta.referencia_documento && (
        <p class="mt-1 text-xs text-slate-500">
          Localização no documento:{' '}
          {proposta.documento_url ? (
            <a
              href={`${withBase(proposta.documento_url)}${proposta.documento_pagina ? `#page=${proposta.documento_pagina}` : ''}`}
              target="_blank"
              rel="noopener noreferrer"
              class="underline hover:text-slate-700"
            >
              {proposta.referencia_documento}
            </a>
          ) : (
            proposta.referencia_documento
          )}
        </p>
      )
    }
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-semibold text-slate-900">Linha do tempo de evidências</h2>
    {
      proposta.evidencias.length === 0 ? (
        <p class="mt-2 text-sm text-slate-500">Nenhuma evidência registrada até o momento.</p>
      ) : (
        <ol class="relative mt-4 border-l border-slate-200 pl-6">
          {proposta.evidencias.map((evidencia) => (
            <li class="mb-6 ml-2 last:mb-0">
              <span class="absolute -left-[7px] mt-1.5 h-3 w-3 rounded-full border-2 border-white bg-slate-400" />
              <time class="text-xs font-medium text-slate-400">{evidencia.data}</time>
              <p class="mt-1 text-sm text-slate-800">{evidencia.descricao}</p>
              <a href={evidencia.fonte_url} class="text-xs text-slate-500 underline">
                {evidencia.fonte_url}
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <p class="mt-10 text-sm text-slate-500">
    Encontrou um erro nesta proposta?{' '}
    <a href={withBase(`/correcao?item=${proposta.id}`)} class="underline hover:text-slate-700">
      Reportar erro com a fonte
    </a>
    .
  </p>
</Layout>
