---
import Layout from '../../layouts/Layout.astro';
import ProposalCard from '../../components/ProposalCard.astro';
import IndicatorComparisonCard from '../../components/IndicatorComparisonCard.astro';
import Timeline from '../../components/Timeline.astro';
import FilterBar from '../../components/FilterBar.astro';
import {
  presidentes,
  getPropostasByPresidente,
  getIndicadoresByPresidente,
  getEixo,
  isMandatoEmAndamento,
} from '../../lib/data';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return presidentes.map((presidente) => ({
    params: { id: presidente.id },
    props: { presidente },
  }));
}

const { presidente } = Astro.props;
const propostasDoMandato = getPropostasByPresidente(presidente.id);
const indicadoresDoMandato = getIndicadoresByPresidente(presidente.id);

// Indicadores em que aumentar é ruim (ao contrário do padrão "aumento é bom")
const CATEGORIAS_AUMENTO_RUIM = new Set([
  'desemprego',
  'inflacao',
  'divida_publica',
  'desmatamento',
  'extrema_pobreza',
  'homicidios',
]);

// Indicadores mostrados só como alta/queda: classificar como melhora ou piora seria juízo de
// valor (dólar mais barato favorece quem importa e prejudica quem exporta; o salário mínimo
// nominal sobe todo ano e não desconta a inflação).
const CATEGORIAS_SEM_JULGAMENTO = new Set(['cambio', 'salario_minimo']);

const emAndamento = isMandatoEmAndamento(presidente);
const cumpridas = propostasDoMandato.filter((p) => p.status === 'cumprido').length;
const percentualGeral =
  propostasDoMandato.length > 0
    ? Math.round(
        propostasDoMandato.reduce((acc, p) => acc + p.percentual_cumprimento, 0) /
          propostasDoMandato.length
      )
    : 0;
---

<Layout title={presidente.nome}>
  <div class="flex flex-wrap items-center gap-4">
    <img
      src={withBase(presidente.foto)}
      alt=""
      class="h-20 w-20 rounded-full bg-trilho object-cover"
    />
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-texto">{presidente.nome}</h1>
      <p class="text-sm text-suave">
        {presidente.mandato_inicio} a {presidente.mandato_fim}
        {emAndamento && (
          <span class="ml-1 inline-flex items-center gap-1 rounded-full bg-andamento-bg px-2 py-0.5 text-xs font-medium text-andamento-texto">
            <span class="h-1.5 w-1.5 rounded-full bg-andamento-ponto" /> Mandato em andamento
          </span>
        )}
        {' '}· {presidente.partido_coligacao}
      </p>
    </div>
    <div class="ml-auto rounded-2xl bg-trilho px-4 py-2 text-center">
      <span class="block text-3xl font-extrabold tracking-tight text-texto">{percentualGeral}%</span>
      <span class="block text-xs text-suave">cumprimento médio ({cumpridas} cumpridas)</span>
    </div>
  </div>

  <section class="mt-10">
    <h2 class="text-lg font-semibold text-texto">
      Ponto de partida vs {emAndamento ? 'situação atual' : 'ponto de chegada'}
    </h2>
    <p class="text-sm text-suave">
      Indicadores objetivos comparando início do mandato com{' '}
      {emAndamento ? 'o dado mais recente disponível (mandato ainda em curso)' : 'o fim do mandato'}.
    </p>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        indicadoresDoMandato.map((indicador) => (
          <IndicatorComparisonCard
            indicador={indicador}
            aumentoEBom={!CATEGORIAS_AUMENTO_RUIM.has(indicador.categoria)}
            semJulgamento={CATEGORIAS_SEM_JULGAMENTO.has(indicador.categoria)}
            mandatoEmAndamento={emAndamento}
          />
        ))
      }
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-lg font-semibold text-texto">
      Linha do tempo do mandato{emAndamento ? ' (em andamento)' : ''}
    </h2>
    <p class="text-sm text-suave">Últimas atualizações de status das propostas.</p>
    <div class="mt-4">
      <Timeline propostas={propostasDoMandato} />
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-lg font-semibold text-texto">Propostas de campanha</h2>
    <div class="mt-4">
      <FilterBar />
    </div>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        propostasDoMandato.map((proposta) => {
          const eixo = getEixo(proposta.eixo);
          return (
            <div data-proposta-item data-eixo={proposta.eixo} data-status={proposta.status}>
              <ProposalCard proposta={proposta} eixo={eixo} />
            </div>
          );
        })
      }
    </div>
  </section>
</Layout>
