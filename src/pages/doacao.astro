---
import QRCode from 'qrcode';
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';
import { isPreenchido } from '../lib/config';
import { isFormularioConfigurado, WEB3FORMS_URL, web3formsAccessKey } from '../lib/formularios';
import { doacao, isPixConfigurado, obterPixCopiaECola } from '../lib/pix';

const pixConfigurado = isPixConfigurado(doacao.pix);

// O QR Code é gerado no build, como SVG inline — a página não depende de serviço externo para exibi-lo.
const pixCopiaECola = pixConfigurado ? obterPixCopiaECola(doacao.pix) : '';
const linkPagamento = isPreenchido(doacao.pix.link_pagamento ?? '') ? doacao.pix.link_pagamento : null;
const qrSvg = pixConfigurado
  ? await QRCode.toString(pixCopiaECola, { type: 'svg', margin: 1, errorCorrectionLevel: 'M' })
  : '';
---

<Layout
  title="Apoie o projeto"
  description="Apoie o Radar de Propostas com uma doação via Pix e solicite uma melhoria para o site."
>
  <h1 class="text-2xl font-bold text-slate-900">Apoie o projeto</h1>
  <p class="mt-2 max-w-3xl text-slate-600">
    O Radar de Propostas é mantido de forma independente. Se o projeto é útil para você, considere
    fazer uma doação via Pix, de qualquer valor. Quem doa pode solicitar uma melhoria para o site
    pelo formulário abaixo.
  </p>

  <div class="mt-6 max-w-3xl rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
    <span class="font-semibold">Neutralidade:</span> doações não influenciam a avaliação de nenhuma
    proposta. Solicitações de melhoria tratam do site (funcionalidades, correções, novos dados), e o
    status de cada proposta continua sendo definido exclusivamente pelos critérios da{' '}
    <a href={withBase('/metodologia')} class="underline">metodologia</a>.
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <section class="rounded-lg border border-slate-200 bg-white p-5">
      <h2 class="text-lg font-semibold text-slate-900">1. Faça sua doação via Pix</h2>

      {
        pixConfigurado ? (
          <div class="mt-4">
            <div
              class="mx-auto w-56 max-w-full rounded-md border border-slate-200 bg-white p-2"
              role="img"
              aria-label="QR Code para doação via Pix"
              set:html={qrSvg}
            />
            <p class="mt-3 text-center text-xs text-slate-500">
              Abra o app do seu banco, escolha pagar com Pix e leia o QR Code. O valor é você quem
              define.
            </p>

            <dl class="mt-5 space-y-2 text-sm text-slate-700">
              <div>
                <dt class="font-semibold">Recebedor</dt>
                <dd>{doacao.pix.nome_recebedor}</dd>
              </div>
              <div>
                <dt class="font-semibold">Chave Pix</dt>
                <dd class="break-all">{doacao.pix.chave}</dd>
              </div>
            </dl>

            <label for="pix-copia-e-cola" class="mt-5 block text-sm font-semibold text-slate-700">
              Pix copia e cola
            </label>
            <div class="mt-1 flex flex-col gap-2 sm:flex-row">
              <input
                id="pix-copia-e-cola"
                type="text"
                readonly
                value={pixCopiaECola}
                class="min-w-0 flex-1 rounded-md border border-slate-300 bg-slate-50 px-3 py-2 font-mono text-xs text-slate-700"
              />
              <button
                type="button"
                id="copiar-pix"
                class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
              >
                Copiar
              </button>
            </div>
            <p id="copiar-pix-status" class="mt-1 h-4 text-xs text-green-700" aria-live="polite" />

            {linkPagamento && (
              <p class="mt-4 text-sm text-slate-700">
                Prefere outra opção?{' '}
                <a href={linkPagamento} target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-900">
                  Abrir a página de pagamento do banco
                </a>
                .
              </p>
            )}
          </div>
        ) : (
          <div class="mt-4 rounded-md bg-slate-50 px-3 py-2 text-sm text-slate-500">
            Dados do Pix ainda não configurados.
          </div>
        )
      }
    </section>

    <section class="rounded-lg border border-slate-200 bg-white p-5">
      <h2 class="text-lg font-semibold text-slate-900">2. Solicite uma melhoria</h2>
      <p class="mt-2 text-sm text-slate-600">
        Depois de doar, descreva a melhoria que você gostaria de ver no site. A solicitação é enviada
        por e-mail para a equipe do projeto, que pode responder no endereço que você informar.
      </p>

      {
        isFormularioConfigurado ? (
          <form id="form-melhoria" action={WEB3FORMS_URL} method="POST" class="mt-4 space-y-4">
            <input type="hidden" name="access_key" value={web3formsAccessKey} />
            <input type="hidden" name="subject" value="Solicitação de melhoria - Radar de Propostas" />
            <input type="hidden" name="from_name" value="Radar de Propostas" />
            {/* Campo invisível contra robôs (honeypot do Web3Forms). */}
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

            <div>
              <label for="nome" class="block text-sm font-semibold text-slate-700">Nome</label>
              <input
                id="nome"
                name="name"
                type="text"
                required
                maxlength="120"
                autocomplete="name"
                class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-slate-700">Seu e-mail</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                maxlength="200"
                autocomplete="email"
                class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
              />
            </div>

            <div>
              <label for="solicitacao" class="block text-sm font-semibold text-slate-700">
                Melhoria solicitada
              </label>
              <textarea
                id="solicitacao"
                name="message"
                required
                rows="6"
                maxlength="5000"
                class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm"
              />
            </div>

            <p class="text-xs text-slate-500">
              Os dados deste formulário são enviados por e-mail por meio do serviço Web3Forms e usados
              apenas para analisar e responder à sua solicitação.
            </p>

            <button
              type="submit"
              class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 disabled:opacity-60"
            >
              Enviar solicitação
            </button>
            <p id="form-melhoria-status" class="text-sm" aria-live="polite" />
          </form>
        ) : (
          <div class="mt-4 rounded-md bg-slate-50 px-3 py-2 text-sm text-slate-500">
            Formulário de solicitação ainda não configurado.
          </div>
        )
      }
    </section>
  </div>
</Layout>

<script>
  import { ativarEnvioWeb3Forms } from '../scripts/web3forms';

  const botaoCopiar = document.getElementById('copiar-pix');
  const campoPix = document.getElementById('pix-copia-e-cola') as HTMLInputElement | null;
  const statusCopiar = document.getElementById('copiar-pix-status');

  botaoCopiar?.addEventListener('click', async () => {
    if (!campoPix || !statusCopiar) return;
    try {
      await navigator.clipboard.writeText(campoPix.value);
      statusCopiar.textContent = 'Código copiado.';
    } catch {
      // Sem acesso à área de transferência: seleciona o texto para a pessoa copiar manualmente.
      campoPix.select();
      statusCopiar.textContent = 'Selecione e copie o código acima.';
    }
  });

  ativarEnvioWeb3Forms('form-melhoria', 'form-melhoria-status', {
    mensagemSucesso: 'Solicitação enviada. Obrigado pelo apoio!',
  });
</script>
